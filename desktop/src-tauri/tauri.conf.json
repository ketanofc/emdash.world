{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emdash",
  "version": "0.1.0",
  "identifier": "world.emdash.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Emdash",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:11434"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "appimage"],
    "icon": []
  }
}
